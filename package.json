{
  "name": "cognirun",
  "private": true,
  "version": "0.1.0",
  "description": "CogniRun Android (Capacitor) wrapper for the web app.",
  "scripts": {
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build": "npm --prefix web install && npm --prefix web run build",
    "start": "node serve-app.mjs",
    "cap:sync": "npx cap sync android",
    "android": "npm run build:web && npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "lint": "eslint .",
    "test": "npm --prefix web test && npm --prefix question-server test",
    "e2e": "playwright test",
    "check": "node scripts/gate.mjs",
    "icons": "node scripts/icons.mjs",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "db:backup": "node scripts/db-backup.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "cf:dev": "npx --yes wrangler@4 pages dev web/dist --port 8788 --compatibility-date=2026-10-01",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7"
  }
}
