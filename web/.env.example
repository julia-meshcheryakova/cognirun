# Copy to web/.env.local to enable the ElevenLabs voice (otherwise the app falls
# back to the browser's built-in SpeechSynthesis). Vite only exposes VITE_* vars.
VITE_ELEVENLABS_API_KEY=
# Optional; defaults to the stock "Rachel" voice 21m00Tcm4TlvDq8ikWAM
VITE_ELEVENLABS_VOICE_ID=
# Optional; enables the LLM-as-a-judge for spoken/typed free-text answers.
# Free Groq API key: https://console.groq.com/keys
VITE_GROQ_API_KEY=
